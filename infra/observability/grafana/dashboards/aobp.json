{
  "uid": "aobp-platform",
  "title": "AOBP \u2014 requests, security and performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"aobp\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"aobp\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP server errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"aobp\",status=~\"5..\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 service latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,instance) (rate(http_server_requests_seconds_bucket{job=\"aobp\"}[2m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Authorization denials",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"aobp\",status=\"403\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\",job=\"aobp\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Successful flight mutations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(aobp_flight_updates_total[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Gateway throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count[2m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
